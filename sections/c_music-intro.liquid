{% comment %}
  Section: 曲紹介（PC=3×3グリッド＋ホバーで右プレビュー / SP=動画上＋サムネ横スライド）
  - ブロック最大9件
  - SP（≤750px）はサムネが横スクロール（scroll-snap）でスワイプ移動
  - YouTubeは youtube-nocookie を使用
{% endcomment %}

<section class="section-{{ section.id }}-padding music-intro color-{{ section.settings.color_scheme }}">
  {% style %}

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_sp }}px;
    padding-bottom: {{ section.settings.padding_bottom_sp }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .music-intro{
    --gap: 20px;
    --thumb-radius: 12px;
    --accent: #111;
  }
  .music-intro .mi-wrap{
    display: grid;
    grid-template-areas: "thumbs preview";
    grid-template-columns: 1fr 1.5fr;
    gap: var(--gap);
    align-items: start;
  }
  /* プレビュー */
  .music-intro .mi-preview{ grid-area: preview; position: sticky; top: clamp(8px, 2vh, 24px); }
  .music-intro .mi-player{ position: relative; width: 100%; aspect-ratio: 16/9; background:#000; border-radius:16px; overflow:hidden; }
  .music-intro .mi-player iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; }

  /* PCのサムネ：3列グリッド */
  .music-intro .mi-thumbs{
    grid-area: thumbs;
    display: grid;
    grid-template-columns: repeat(3, minmax(0,1fr));
    gap: var(--gap);
  }

  /* サムネ共通 */
  .music-intro .mi-thumb{
    appearance:none; border:0; padding:0; margin:0;
    display:block; width:100%; cursor:pointer; background:transparent;
    border-radius: var(--thumb-radius); overflow:hidden; position:relative;
  }
  .music-intro .mi-thumb:focus-visible{ outline:3px solid var(--accent); outline-offset:2px; }
  .music-intro .mi-thumb .mi-thumb-img{ width:100%; height:auto; display:block; aspect-ratio:1/1; object-fit:cover; transform:translateZ(0); }
  .music-intro .mi-thumb .mi-thumb-label{
    position:absolute; left:8px; bottom:8px; background:rgba(0,0,0,.55); color:#fff;
    font-size:12px; line-height:1; padding:6px 8px; border-radius:999px; max-width:90%;
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
  }
  .music-intro .mi-thumb.is-active::after{ content:""; position:absolute; inset:0; box-shadow: inset 0 0 0 3px var(--accent); border-radius: var(--thumb-radius); }

  /* —— スマホ（≤750px）だけ：縦並び → 動画上 + サムネ横スライド —— */
  @media (max-width: 750px){
    .music-intro .mi-wrap{ grid-template-areas: "preview" "thumbs"; grid-template-columns:1fr; gap:12px; }

    /* 横スライドのレール化（スワイプ可能） */
    .music-intro .mi-thumbs{
      display:flex; gap:12px;
      overflow-x:auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      padding-bottom: 6px;
    }
    .music-intro .mi-thumbs::-webkit-scrollbar{ display:none; }

    /* 1画面に3枚見える幅（ギャップ2つを差し引いて等分） */
    .music-intro .mi-thumb{
      flex: 0 0 calc((100% - 2*12px) / 3);
      scroll-snap-align: start;
    }
  }

  /* 横はみ出しの保険（任意） */
  html, body { overflow-x: hidden; }
  @supports (overflow-x: clip){ html, body { overflow-x: clip; } }
  {% endstyle %}

  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="mi-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="mi-wrap" id="music-{{ section.id }}">
      <!-- プレビュー -->
      <div class="mi-preview">
        <div class="mi-player">
          <iframe
            id="mi-player-{{ section.id }}"
            class="mi-iframe"
            title="YouTube preview"
            src="" loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin">
          </iframe>
        </div>
      </div>

      <!-- サムネ -->
      <div class="mi-thumbs">
        {%- assign count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'video_item' and block.settings.youtube != blank and block.settings.thumbnail != blank -%}
            {%- assign count = count | plus: 1 -%}
            <button
              type="button"
              class="mi-thumb"
              data-video-id="{{ block.settings.youtube.id }}"
              aria-controls="mi-player-{{ section.id }}"
              aria-label="{{ block.settings.title | default: '動画' | escape }}"
              {{ block.shopify_attributes }}>
              <img
                class="mi-thumb-img"
                src="{{ block.settings.thumbnail | image_url: width: 600 }}"
                srcset="
                  {{ block.settings.thumbnail | image_url: width: 300 }} 300w,
                  {{ block.settings.thumbnail | image_url: width: 600 }} 600w,
                  {{ block.settings.thumbnail | image_url: width: 900 }} 900w"
                sizes="(max-width: 750px) 33vw, 20vw"
                width="600" height="600"
                alt="{{ block.settings.title | default: 'サムネ' | escape }}">
              {%- if block.settings.title != blank -%}
                <span class="mi-thumb-label">{{ block.settings.title }}</span>
              {%- endif -%}
            </button>
            {%- if count == 9 -%}{% break %}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script>
  (function(){
    function init(root){
      if(!root) return;
      const frame = root.querySelector('.mi-iframe');
      const thumbs = Array.from(root.querySelectorAll('.mi-thumb'));
      if (!frame || !thumbs.length) return;

      const embed = (id, autoplay) =>
        'https://www.youtube-nocookie.com/embed/' + id +
        '?rel=0&modestbranding=1&playsinline=1&mute=1' + (autoplay ? '&autoplay=1' : '');

      let current = null;
      function select(btn, autoplay){
        const id = btn.dataset.videoId;
        if(!id || id === current) return;
        current = id;
        frame.src = embed(id, autoplay);
        thumbs.forEach(t => t.classList.toggle('is-active', t === btn));

        /* SP時：選択したサムネを中央付近にスクロール（体験向上） */
        if (window.matchMedia('(max-width: 750px)').matches) {
          btn.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
        }
      }

      /* 初期選択：先頭 */
      select(thumbs[0], false);

      /* PC: hover/focus, SP: tap/click */
      thumbs.forEach(btn => {
        btn.addEventListener('mouseenter', () => {
          if (window.matchMedia('(hover: hover)').matches) select(btn, true);
        });
        btn.addEventListener('focus', () => select(btn, false));
        btn.addEventListener('click', () => select(btn, true));
      });
    }

    const root = document.getElementById('music-{{ section.id }}');
    document.addEventListener('DOMContentLoaded', () => init(root));
    document.addEventListener('shopify:section:load', (e) => { if(e.target.contains(root)) init(root); });
  })();
  </script>
</section>

{% schema %}
{
  "name": "曲紹介（YouTubeプレビュー：SPスライド）",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "曲紹介" },
    { "type": "color_scheme", "id": "color_scheme", "label": "カラー（スキーム）", "default": "background-1" },
    {
        "type": "header",
        "content": "デスクトップ"
      }, {
        "type": "range",
        "id": "padding_top",
        "label": "上部の余白",
        "unit": "px",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 0
      }, {
        "type": "range",
        "id": "padding_bottom",
        "label": "下部の余白",
        "unit": "px",
        "min": 0,
        "max": 200,
        "step": 2,
        "default": 0
      }, {
        "type": "header",
        "content": "モバイル"
      }, {
        "type": "range",
        "id": "padding_top_sp",
        "label": "上部の余白",
        "unit": "px",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
      }, {
        "type": "range",
        "id": "padding_bottom_sp",
        "label": "下部の余白",
        "unit": "px",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 0
      }
  ],
  "blocks": [
    {
      "type": "video_item",
      "name": "曲カード",
      "settings": [
        { "type": "image_picker", "id": "thumbnail", "label": "サムネ画像" },
        { "type": "video_url", "id": "youtube", "label": "YouTube URL", "accept": ["youtube"] },
        { "type": "text", "id": "title", "label": "タイトル（任意）" }
      ]
    }
  ],
  "presets": [
    { "name": "曲紹介（YouTubeプレビュー：SPスライド）" }
  ]
}
{% endschema %}
