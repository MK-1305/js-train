{{ 'c_parallax.css' | asset_url | stylesheet_tag }}

{% comment %} 下記で親要素にstyleを当てることができる {% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} {
    display: contents;
  }
{% endstyle %}

{%- comment -%} オーバーレイ（動画があり、オーバーレイ画像もある場合のみ） {%- endcomment -%}
{% if section.settings.video != blank and section.settings.image_overlay != blank %}
  <div class="c_parallax__overlay">
    <div class="c_parallax__image c_parallax-overlay__image">
      <picture>
        {% if section.settings.image_overlay_sp != blank %}
          <source srcset="{{ section.settings.image_overlay_sp | image_url: width: 800 }}" media="(max-width: 750px)">
        {% endif %}
        <img
          class="c_image"
          src="{{ section.settings.image_overlay | image_url: width: 3840 }}"
          width="1920"
          height="800"
          alt="{{ section.settings.image_overlay.alt }}">
      </picture>
    </div>
  </div>
{% endif %}


{%- comment -%} メインとなる動画 {%- endcomment -%}
{% if section.settings.video != blank or section.settings.video_sp != blank %}
  <div class="c_parallax-section">
    <div class="c_parallax__wrapper">
      <div class="c_parallax__image">
        {%- comment -%} PC 用動画 {%- endcomment -%}
        {% if section.settings.video != blank %}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: "metadata", class: "c_image c_parallax__video c_parallax__video--pc"
          }}
        {% endif %}

        {%- comment -%} SP 用動画（未設定ならPC用がそのまま表示されます） {%- endcomment -%}
        {% if section.settings.video_sp != blank %}
          {{ section.settings.video_sp | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: "metadata", class: "c_image c_parallax__video c_parallax__video--sp"
          }}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}


{%- comment -%} 装飾画像とテキスト {%- endcomment -%}
{% if section.settings.video != blank or section.settings.video_sp != blank %}
  <div class="c_parallax__image c_parallax__decoration">
    {% if section.settings.image_decoration != blank %}
      <div class="c_parallax__decoration__inner">
        <div class="c_parallax__decoration-image">
          <img
            class="c_image"
            src="{{ section.settings.image_decoration | image_url: width: 3840 }}"
            width="1920"
            height="800"
            alt="{{ section.settings.image_decoration.alt }}">
        </div>
        {% if section.settings.textarea != blank %}
          <div class="c_parallax__decoration-text">
            {{ section.settings.textarea | newline_to_br }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endif %}


{% schema %}
  {
    "name": "カスタムパララックス",
    "settings": [
      {
        "type": "video",
        "id": "video",
        "label": "動画(PC)"
      },
      {
        "type": "video",
        "id": "video_sp",
        "label": "動画(SP)"
      },

      {
        "type": "image_picker",
        "id": "image_overlay",
        "label": "オーバーレイ(PC)"
      },
      {
        "type": "image_picker",
        "id": "image_overlay_sp",
        "label": "オーバーレイ(SP)"
      }, {
        "type": "image_picker",
        "id": "image_decoration",
        "label": "装飾"
      }, {
        "type": "textarea",
        "id": "textarea",
        "label": "テキスト",
        "default": "ここにテキストを入力"
      }
    ],
    "presets": [
      {
        "name": "カスタムパララックス",
        "category": "カスタム"
      }
    ]
  }
{% endschema %}